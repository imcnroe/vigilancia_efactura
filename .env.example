DATABASE_URL=postgresql+psycopg://regwatch:regwatch@localhost:5432/regwatch

# s3 (MinIO en local, ver docker-compose.yml) o local (disco, solo para desarrollo).
ARTIFACT_STORE=s3
ARTIFACT_LOCAL_ROOT=var/artifacts
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=regwatch
S3_SECRET_KEY=regwatch123
S3_BUCKET=regwatch-artifacts
S3_REGION=us-east-1

# Obligatorio antes de salir a la red. Tiene que llevar una URL de contacto o un correo
# que alguien lea: es lo que un administrador de la AEAT mira en sus logs cuando quiere
# saber quien le descarga esquemas cada manana (apartado 7.1). Basta con uno de los dos,
# pero lo util es poner los dos: la URL explica que hace el programa y el correo permite
# pararlo a quien no tenga ganas de leer nada.
COLLECTOR_USER_AGENT=regwatch/0.1 (proyecto de I+D personal; +https://github.com/TODO_VERIFICAR; contacto@TODO_VERIFICAR)
COLLECTOR_TIMEOUT_SECONDS=30
COLLECTOR_MAX_ATTEMPTS=3

# Permite descargar con un User-Agent sin datos de contacto. SOLO para descargas
# manuales y supervisadas durante el desarrollo: la vigilancia diaria desatendida es
# justo lo que necesita ser identificable. Cada uso deja un aviso en el log, y no sirve
# para saltarse el TODO_VERIFICAR.
COLLECTOR_ALLOW_ANONYMOUS=false

# Fallos consecutivos de una fuente a partir de los cuales se abre una incidencia.
HEARTBEAT_FAILURE_THRESHOLD=2

LOG_LEVEL=INFO
